@{

}
<h1 class="text-center">Registrazione Nuovo Verbale</h1>

<form asp-controller="Verbali" asp-action="Insert" method="post">
    <div class="mb-3">
        <label class="form-label text-black">Data Violazione</label>
        <input type="date" class="form-control" name="DataViolazione">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Indirizzo Violazione</label>
        <input type="text" class="form-control" name="IndirizzoViolazione">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Nominativo Agente</label>
        <input type="text" class="form-control" name="NominativoAgente">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Data Trascrizione Verbale</label>
        <input type="date" class="form-control" name="DataTrascrizioneVerbale">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Importo</label>
        <input type="number" class="form-control" name="Importo">
    </div>
    <div class="mb-3">
        <label class="form-label text-black">Decurtamento Punti</label>
        <input type="number" class="form-control" name="DecurtamentoPunti">
    </div>

    <button class="btn btn-primary" type="submit">Salva</button>

</form>
