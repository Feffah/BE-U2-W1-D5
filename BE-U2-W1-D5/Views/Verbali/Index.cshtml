
@{
}
<h1 class="text-center">Lista Verbali</h1>
<button class="btn btn-primary"><a class="text-white text-decoration-none" asp-controller="Verbali" asp-action="Insert">Registra Verbale</a></button>
<table class="table mt-4">
    <thead>
        <tr class="text-white bg-dark">
            <th scope="col">DataViolazione</th>
            <th scope="col">IndirizzoViolazione</th>
            <th scope="col">NominativoAgente</th>
            <th scope="col">DataTrascrizioneVerbale</th>
            <th scope="col">Importo</th>
            <th scope="col">DecurtamentoPunti</th>
            <th scope="col">Trasgressore</th>
            <th scope="col">Modifica</th>
            <th scope="col">Cancella</th>
        </tr>
    </thead>
    <tbody>
        @foreach (BE_U2_W1_D5.Models.Entity.Verbale verbale in ViewBag.Verbali)
        {

            <tr class="text-white bg-dark">
                <td>@verbale.DataViolazione</td>
                <td>@verbale.IndirizzoViolazione</td>
                <td>@verbale.NominativoAgente</td>
                <td>@verbale.DataTrascrizioneVerbale</td>
                <td>@verbale.Importo</td>
                <td>@verbale.DecurtamentoPunti</td>
                <td>@if(verbale.anagrafica != null){@verbale.anagrafica.Cognome}</td>
                <td class="text-center">
                    <a asp-controller="Verbali" asp-action="Update" asp-route-Id="@verbale.IDVerbale">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                        </svg>
                    </a>
                </td>
                <td>
                    <form asp-controller="Verbali" asp-action="Delete" asp-route-id="@verbale.IDVerbale" method="post" style="display:inline">
                        <button class="text-black" type="submit" onclick="return confirm('Sei sicuro di voler cancellare questo trasgressore?');"
                                style="border:none; background:none; padding:0;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5" />
                            </svg>
                        </button>
                    </form>
                </td>

            </tr>

        }
    </tbody>
</table>