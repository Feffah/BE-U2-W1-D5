@model BE_U2_W1_D5.Models.Entity.Anagrafica
@{

}
<h1 class="text-center">Modifica Dati Anagrafici Trasgressori</h1>

<form asp-controller="Anagrafe" asp-action="Update" method="post">
    <input type="text" class="form-control" name="IDAnagrafica" value="@Model.IDAnagrafica" hidden>

    <div class="mb-3">
        <label class="form-label text-black">Cognome</label>
        <input type="text" class="form-control" name="Cognome" value="@Model.Cognome">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Nome</label>
        <input type="text" class="form-control" name="Nome" value="@Model.Nome">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Indirizzo</label>
        <input type="text" class="form-control" name="Indirizzo" value="@Model.Indirizzo">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">Città</label>
        <input type="text" class="form-control" name="Citta" value="@Model.Citta">
    </div>

    <div class="mb-3">
        <label class="form-label text-black">CAP</label>
        <input type="number" class="form-control" name="CAP" value="@Model.CAP">
    </div>
    <div class="mb-3">
        <label class="form-label text-black">Codice Fiscale</label>
        <input type="text" class="form-control" name="CodiceFiscale" value="@Model.CodiceFiscale">
    </div>

    <button class="btn btn-primary" type="submit">Salva</button>

</form>

